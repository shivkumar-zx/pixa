# Prevent Apache / LiteSpeed from compressing image and binary files
<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI "\.(?:gif|jpe?g|png|webp|mp4|zip|pdf)$" no-gzip dont-vary
</IfModule>

# Force browsers, proxies, and LiteSpeed never to transform or downscale images
# Enable full CORS including PUT for direct browser uploads
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS, DELETE"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Origin, Accept"
    Header set Cache-Control "no-transform"
</IfModule>

# LiteSpeed Web Server - Disable automatic image optimization on uploads
<IfModule LiteSpeed>
    CacheDisable
</IfModule>
